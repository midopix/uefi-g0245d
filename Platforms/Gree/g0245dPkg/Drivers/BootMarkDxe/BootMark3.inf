## @file
#  BootMarkDxe #3 - boot progress marker (palette index 3: cyan).
#
#  The palette index is hard-coded in BootMark3.c.  Do NOT try to pass it via
#  INF [BuildOptions]: this build chain drops INF-level build options and the
#  four modules silently become byte-identical (v84 pitfall).
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = BootMark3
  FILE_GUID                      = 4331CF50-89F5-4B40-8487-2265F3B3E479
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = BootMarkDxeEntryPoint

[Sources]
  BootMark3.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  DebugLib

[Protocols]
  gEfiGraphicsOutputProtocolGuid         ## CONSUMES

[Depex]
  TRUE
