## @file
#  BootMarkDxe #2 - boot progress marker (palette index 2: magenta).
#
#  The palette index is hard-coded in BootMark2.c.  Do NOT try to pass it via
#  INF [BuildOptions]: this build chain drops INF-level build options and the
#  four modules silently become byte-identical (v84 pitfall).
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = BootMark2
  FILE_GUID                      = D8173B55-A5E2-44B2-9588-2BF5C50F8AFB
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = BootMarkDxeEntryPoint

[Sources]
  BootMark2.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  DebugLib

[Protocols]
  gEfiGraphicsOutputProtocolGuid         ## CONSUMES

[Depex]
  TRUE
