##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = KeypadDeviceLib
  FILE_GUID                      = 3E1B7A6C-5D42-4F18-9C3A-7B2E8D4F1A09
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = KeypadDeviceLib
  CONSTRUCTOR                    = KeypadDeviceConstructor

[Sources.common]
  KeypadDeviceLib.c

[Packages]
  MdePkg/MdePkg.dec
  Msm8996Pkg/Msm8996Pkg.dec
  SiliciumPkg/SiliciumPkg.dec

[LibraryClasses]
  BaseMemoryLib
  DebugLib
  IoLib
  Msm8996SpmiLib
